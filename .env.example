# BizPilot AI environment variables
#
# Copy to .env.local and fill in the values for your environment.
# .env.local is gitignored. Never commit real credentials.

# --- Supabase (required) ---
# Project URL and anon key are exposed to the browser, so they are safe to ship.
# Use the anon key, never the service role key, in anything client-visible.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Grants full database access, bypassing row level security.
# Used by every API route. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# --- App ---
NEXT_PUBLIC_APP_NAME=BizPilot AI

# --- AI (optional) ---
# Without this the AI draft and next-best-action features fall back to
# deterministic templates. The app works, it just is not using a model.
OPENAI_API_KEY=

# --- Email reminders (optional) ---
# Powers the daily follow-up digest via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BizPilot AI <reminders@your-domain.com>

# --- WhatsApp reminders (optional) ---
# Requires an approved Meta message template before it will send.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Cron (required in production) ---
# Vercel calls /api/reminders/send daily at 07:00 via the cron entry in
# vercel.json. Without this the endpoint returns 401 and every scheduled run
# fails. Use a long random string.
CRON_SECRET=
